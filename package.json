{
  "name": "@raviolelabs/argosmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise MCP access gateway with human approvals and scoped Engram contexts",
  "scripts": {
    "dev": "tsx src/main.ts",
    "demo": "ARGOS_DEMO=1 tsx src/main.ts",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.cloudflare.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
    "build:cloudflare": "vite build --mode cloudflare",
    "deploy": "cf deploy --mode cloudflare",
    "local": "tsx src/local/main.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "format": "prettier --write src web desktop/ui cloudflare tests scripts *.ts *.json .github/workflows",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "better-sqlite3": "13.2.0",
    "express": "5.2.1",
    "jose": "6.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "5.20261117.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.18.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "cf": "1.0.0-rc.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "license": "MIT"
}
